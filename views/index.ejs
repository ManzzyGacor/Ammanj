<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manzzy ID - Platform AM Creator Premium</title>
    <link rel="preconnect" href="https://cdn.tailwindcss.com">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config = { darkMode: 'class' }</script>
    <style>
        @keyframes float { 0% { transform: translateY(0px); } 50% { transform: translateY(-12px); } 100% { transform: translateY(0px); } }
        .animate-float { animation: float 4s ease-in-out infinite; display: inline-block; }
        .glass-card { background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(12px); border: 1px solid rgba(51, 65, 85, 0.5); }
    </style>
</head>
<body style="background-color: #020617; color: white;" class="bg-slate-950 text-white font-sans overflow-x-hidden selection:bg-indigo-500 selection:text-white">
    
    <!-- NAVBAR -->
    <nav class="fixed w-full z-40 bg-slate-950/80 backdrop-blur-md border-b border-slate-800/80 transition-all duration-300">
        <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
            <div class="text-2xl font-black tracking-wider text-indigo-400 drop-shadow-[0_0_10px_rgba(99,102,241,0.5)]">
                MANZZY<span class="text-white">.ID</span>
            </div>
            <div class="flex items-center gap-4">
                <% if (user) { %>
                    <a href="/dashboard" class="bg-indigo-600 hover:bg-indigo-500 px-6 py-2.5 rounded-xl font-bold shadow-[0_0_15px_rgba(99,102,241,0.4)] hover:shadow-[0_0_25px_rgba(99,102,241,0.6)] transition transform hover:-translate-y-0.5">Masuk Dashboard 🚀</a>
                <% } else { %>
                    <a href="/login" class="text-slate-300 hover:text-white font-semibold transition">Masuk</a>
                    <a href="/register" class="bg-indigo-600 hover:bg-indigo-500 px-6 py-2.5 rounded-xl font-bold shadow-[0_0_15px_rgba(99,102,241,0.4)] hover:shadow-[0_0_25px_rgba(99,102,241,0.6)] transition transform hover:-translate-y-0.5">Daftar</a>
                <% } %>
            </div>
        </div>
    </nav>

    <!-- HERO SECTION -->
    <header class="relative pt-40 pb-20 px-6 overflow-hidden">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-indigo-600/20 rounded-full blur-[120px] -z-10"></div>
        
        <div class="max-w-4xl mx-auto text-center relative z-10">
            <div class="inline-block mb-4 px-4 py-1.5 rounded-full bg-slate-900 border border-indigo-500/30 text-indigo-400 text-sm font-semibold tracking-wide shadow-[0_0_10px_rgba(99,102,241,0.1)]">
                ✨ Create Alight Motion Premium Hadir
            </div>
            <h1 class="text-5xl md:text-7xl font-extrabold mb-8 leading-tight">
                Generate Akun AM Premium <br>
                <span class="bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400 bg-clip-text text-transparent drop-shadow-[0_0_15px_rgba(168,85,247,0.4)] animate-float">Secara Instan.</span>
            </h1>
            <p class="text-slate-400 text-lg md:text-xl mb-10 max-w-2xl mx-auto leading-relaxed">
                Platform generator Premium dan manajemen role otomatis terbaik. Dilengkapi dengan gateway pembayaran instan untuk kemudahan akses tanpa batas.
            </p>
            <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
                <a href="/register" class="w-full sm:w-auto bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-8 py-4 rounded-2xl shadow-[0_0_20px_rgba(99,102,241,0.5)] hover:shadow-[0_0_30px_rgba(99,102,241,0.7)] transition transform hover:-translate-y-1 text-lg">
                    Mulai Sekarang Secara Gratis
                </a>
                <a href="#fitur" class="w-full sm:w-auto bg-slate-800 hover:bg-slate-700 text-white font-bold px-8 py-4 rounded-2xl border border-slate-700 transition text-lg">
                    Pelajari Fitur
                </a>
            </div>
        </div>
    </header>

    <!-- FITUR SECTION -->
    <section id="fitur" class="py-20 px-6">
        <div class="max-w-6xl mx-auto">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-4xl font-bold mb-4">Fitur Unggulan Kami</h2>
                <p class="text-slate-400">Dirancang khusus untuk efisiensi dan keamanan maksimal.</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Card 1 -->
                <div class="glass-card p-8 rounded-3xl hover:border-indigo-500/50 hover:shadow-[0_0_30px_rgba(99,102,241,0.15)] transition duration-300 group">
                    <div class="w-14 h-14 bg-indigo-500/20 rounded-2xl flex items-center justify-center mb-6 text-3xl group-hover:scale-110 transition transform">⚡</div>
                    <h3 class="text-xl font-bold mb-3">Sistem Otomatis 24/7</h3>
                    <p class="text-slate-400 leading-relaxed">Generate link verifikasi dan aktivasi Alight Motion secara instan kapan saja tanpa perlu menunggu admin.</p>
                </div>
                <!-- Card 2 -->
                <div class="glass-card p-8 rounded-3xl hover:border-emerald-500/50 hover:shadow-[0_0_30px_rgba(16,185,129,0.15)] transition duration-300 group">
                    <div class="w-14 h-14 bg-emerald-500/20 rounded-2xl flex items-center justify-center mb-6 text-3xl group-hover:scale-110 transition transform">💳</div>
                    <h3 class="text-xl font-bold mb-3">Pembayaran Instan (QRIS)</h3>
                    <p class="text-slate-400 leading-relaxed">Topup dan beli role Premium/Reseller secara mandiri didukung oleh sistem pembayaran otomatis.</p>
                </div>
                <!-- Card 3 -->
                <div class="glass-card p-8 rounded-3xl hover:border-purple-500/50 hover:shadow-[0_0_30px_rgba(168,85,247,0.15)] transition duration-300 group">
                    <div class="w-14 h-14 bg-purple-500/20 rounded-2xl flex items-center justify-center mb-6 text-3xl group-hover:scale-110 transition transform">👑</div>
                    <h3 class="text-xl font-bold mb-3">Manajemen Role Bertingkat</h3>
                    <p class="text-slate-400 leading-relaxed">Sistem role dinamis mulai dari User, Premium, Reseller, hingga Admin dengan panel khusus untuk mengatur member.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="border-t border-slate-800/80 py-8 mt-10">
        <div class="max-w-6xl mx-auto px-6 text-center text-slate-500 text-sm">
            &copy; 2026 Manzzy ID. All rights reserved. <br>
            Coded with 💙 for the community.
        </div>
    </footer>

    <!-- MODAL FLOATING PROMO VARESAMD -->
    <div id="promo-modal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-[100] flex items-center justify-center p-4 opacity-0 transition-opacity duration-500">
        <div class="bg-slate-900 rounded-3xl max-w-sm md:max-w-md w-full border border-indigo-500/50 shadow-[0_0_30px_rgba(99,102,241,0.3)] overflow-hidden relative transform scale-95 transition-transform duration-500" id="promo-content">
            
            <button onclick="closePromo()" class="absolute top-3 right-3 bg-slate-950/80 text-slate-300 hover:text-white p-2 rounded-full z-20 backdrop-blur-md transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
            
            <div class="relative h-48 w-full">
                <img src="https://raw.githubusercontent.com/ManzzyGacor/Urlmanzzy/main/file_1787080202458_944.jpg" alt="VaresaMD" class="w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900 to-transparent"></div>
            </div>

            <div class="p-6 text-center -mt-6 relative z-10">
                <h2 class="text-3xl font-black mb-2 bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400 bg-clip-text text-transparent drop-shadow-[0_0_10px_rgba(99,102,241,0.6)]">VaresaMD Bot</h2>
                <p class="text-emerald-400 font-extrabold text-xl mb-4 drop-shadow-[0_0_8px_rgba(52,211,153,0.8)]">Mulai dari Rp 1.000 🔥</p>
                
                <div class="flex flex-wrap justify-center gap-2 mb-6">
                    <span class="px-3 py-1 bg-indigo-500/10 border border-indigo-500/40 rounded-full text-xs font-semibold text-indigo-300 shadow-[0_0_10px_rgba(99,102,241,0.1)]">🤖 Cek MLBB</span>
                    <span class="px-3 py-1 bg-purple-500/10 border border-purple-500/40 rounded-full text-xs font-semibold text-purple-300 shadow-[0_0_10px_rgba(168,85,247,0.1)]">🛡️ Anti Link</span>
                    <span class="px-3 py-1 bg-pink-500/10 border border-pink-500/40 rounded-full text-xs font-semibold text-pink-300 shadow-[0_0_10px_rgba(236,72,153,0.1)]">🎮 Game Seru</span>
                </div>

                <a href="https://sewa.manzzy.web.id/" target="_blank" onclick="closePromo()" class="block w-full bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-3.5 rounded-xl shadow-[0_0_15px_rgba(99,102,241,0.5)] hover:shadow-[0_0_25px_rgba(99,102,241,0.8)] transition transform hover:-translate-y-1">
                    Cek Website Sekarang 🚀
                </a>
            </div>
        </div>
    </div>

    <script>
        // Trigger Popup Promo Saat Halaman Awal Dibuka
        document.addEventListener("DOMContentLoaded", () => {
            const promoModal = document.getElementById('promo-modal');
            const promoContent = document.getElementById('promo-content');
            
            // Cek apakah promo sudah pernah muncul di sesi ini
            if(!sessionStorage.getItem('promoShownIndex')) {
                setTimeout(() => {
                    promoModal.classList.remove('hidden');
                    void promoModal.offsetWidth; 
                    promoModal.classList.remove('opacity-0');
                    promoContent.classList.remove('scale-95');
                    sessionStorage.setItem('promoShownIndex', 'true');
                }, 1000); // Muncul 1 detik setelah halaman dimuat
            }
        });

        function closePromo() {
            const promoModal = document.getElementById('promo-modal');
            const promoContent = document.getElementById('promo-content');
            
            promoModal.classList.add('opacity-0');
            promoContent.classList.add('scale-95');
            
            setTimeout(() => {
                promoModal.classList.add('hidden');
            }, 500);
        }
    </script>
</body>
</html>