<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Manzzy ID</title>
    <link rel="preconnect" href="https://cdn.tailwindcss.com">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config = { darkMode: 'class' }</script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        @keyframes float { 0% { transform: translateY(0px); } 50% { transform: translateY(-8px); } 100% { transform: translateY(0px); } }
        .animate-float { animation: float 3s ease-in-out infinite; display: inline-block; }
        .glass-card { background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(16px); border: 1px solid rgba(51, 65, 85, 0.5); }
        .step-active { color: #818cf8; font-weight: bold; }
        .step-inactive { color: #475569; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
    </style>
</head>
<body style="background-color: #020617; color: white;" class="bg-slate-950 text-white min-h-screen px-4 md:px-6 py-10 relative selection:bg-indigo-500">
    
    <!-- Background Glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-indigo-600/10 rounded-full blur-[150px] -z-10 pointer-events-none"></div>

    <div class="max-w-6xl mx-auto">
        <!-- HEADER -->
        <div class="glass-card p-6 md:p-8 rounded-3xl mb-8 flex flex-col md:flex-row justify-between items-center shadow-[0_0_30px_rgba(0,0,0,0.3)]">
            <div class="text-center md:text-left mb-4 md:mb-0">
                <h1 class="text-3xl font-black mb-1 bg-gradient-to-r from-white to-slate-400 bg-clip-text text-transparent">Halo, <%= user.name %>! <span class="animate-float">👋</span></h1>
                <p class="text-slate-400 mt-1">Username: <span class="text-indigo-400 font-mono">@<%= user.username %></span></p>
                <div class="mt-3">
                    <span class="px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 shadow-[0_0_10px_rgba(99,102,241,0.2)]">
                        Role: <%= user.role %> 👑
                    </span>
                </div>
            </div>
            <div class="flex gap-4">
                <% if (['reseller', 'admin', 'raja'].includes(user.role)) { %>
                    <a href="/manage-members" class="bg-indigo-600 hover:bg-indigo-500 px-5 py-3 rounded-xl font-bold shadow-[0_0_15px_rgba(99,102,241,0.4)] transition transform hover:-translate-y-0.5 text-sm">⚙️ Kelola</a>
                <% } %>
                <a href="/logout" class="bg-slate-800 hover:bg-red-500/20 text-slate-300 hover:text-red-400 px-5 py-3 rounded-xl font-bold border border-slate-700 hover:border-red-500/30 transition transform hover:-translate-y-0.5 text-sm">Keluar</a>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
            <!-- PANEL AM GENERATOR -->
            <div class="glass-card p-6 md:p-8 rounded-3xl shadow-[0_0_30px_rgba(0,0,0,0.3)] hover:border-indigo-500/30 transition duration-300 flex flex-col justify-between">
                <div>
                    <h2 class="text-2xl font-black mb-2 text-indigo-400 flex items-center gap-2">🔥 Generate AM</h2>
                    <p class="text-sm text-slate-400 mb-6 border-b border-slate-800/60 pb-4">Status Limit Anda: <span class="text-emerald-400 font-bold"><%= user.role === 'user' ? '1x Sehari' : 'Unlimited' %></span></p>
                    
                    <div class="flex items-center justify-between mb-8 bg-slate-900/50 p-2 rounded-2xl border border-slate-800 text-xs md:text-sm">
                        <div id="ui-step-1" class="step-active text-center w-1/3 py-2 rounded-xl bg-slate-800/80 shadow-md">1. Email <span class="animate-float">📧</span></div>
                        <div id="ui-step-2" class="step-inactive text-center w-1/3 py-2">2. Verif <span class="animate-float">🔗</span></div>
                        <div id="ui-step-3" class="step-inactive text-center w-1/3 py-2">3. Done <span class="animate-float">🎉</span></div>
                    </div>
                </div>

                <div id="am-form-container">
                    <input type="email" id="am-email" placeholder="Masukkan akun Gmail..." class="w-full bg-slate-900/80 border border-slate-700 rounded-xl px-5 py-4 text-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 mb-4 outline-none transition">
                    <button onclick="processAm(1)" id="btn-am" class="w-full bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 font-bold py-4 rounded-xl shadow-[0_0_20px_rgba(99,102,241,0.4)] transition transform hover:-translate-y-0.5">Kirim Magic Link</button>
                </div>
            </div>

            <!-- LEADERBOARD & LOGS -->
            <div class="flex flex-col gap-6">
                <div class="glass-card p-6 rounded-3xl shadow-[0_0_30px_rgba(0,0,0,0.3)] hover:border-emerald-500/30 transition duration-300">
                    <h2 class="text-xl font-bold mb-4 flex items-center gap-2">🏆 Top Spender</h2>
                    <div class="space-y-3">
                        <% leaderboard.forEach((u, index) => { %>
                            <div class="flex justify-between items-center bg-slate-900/50 p-3.5 rounded-xl border border-slate-700/50 hover:bg-slate-800/50 transition">
                                <div class="font-bold flex items-center gap-3 text-sm md:text-base">
                                    <span class="w-6 h-6 flex items-center justify-center bg-slate-800 rounded-full text-xs"><%= index + 1 %></span>
                                    <%= u.username %>
                                </div>
                                <div class="text-emerald-400 font-bold text-sm md:text-base drop-shadow-[0_0_5px_rgba(52,211,153,0.3)]">Rp <%= u.totalSpent.toLocaleString('id-ID') %></div>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <div class="glass-card p-6 rounded-3xl shadow-[0_0_30px_rgba(0,0,0,0.3)] hover:border-pink-500/30 transition duration-300">
                    <h2 class="text-xl font-bold mb-4 flex items-center gap-2">📜 Log Global</h2>
                    <div class="space-y-3 h-32 overflow-y-auto pr-2">
                        <% globalTrx.forEach(trx => { %>
                            <div class="text-sm text-slate-400 bg-slate-900/30 p-3 rounded-xl border border-slate-800/50">
                                <span class="text-white font-semibold">@<%= trx.username %></span> membeli role <span class="text-indigo-400 uppercase font-bold"><%= trx.roleTarget %></span> ✅
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>

        <!-- PRICING SECTION (DIUBAH JADI GRID 3 KOLOM MENYAMPING) -->
        <div class="text-center mb-10 mt-16">
            <h2 class="text-3xl md:text-4xl font-black bg-gradient-to-r from-white to-slate-400 bg-clip-text text-transparent mb-3">🛒 Upgrade Role Permanen</h2>
            <p class="text-slate-400 text-sm md:text-base">Pilih paket sesuai kebutuhan. Transaksi diproses instan 24/7 via QRIS.</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
            <% const roles = [ 
                { id: 'premium', name: 'Premium', price: 2000, emoji: '🌟', color: 'indigo', desc: 'Unlimited Verif AM' },
                { id: 'reseller', name: 'Reseller', price: 4000, emoji: '💼', color: 'purple', desc: 'Bisa Jual/Set Role Premium' },
                { id: 'admin', name: 'Admin', price: 10000, emoji: '👑', color: 'pink', desc: 'Bisa Jual Reseller & Premium' }
            ]; %>
            <% roles.forEach(r => { %>
                <div class="glass-card p-6 md:p-8 rounded-3xl text-center hover:border-<%= r.color %>-500/50 hover:shadow-[0_0_30px_rgba(168,85,247,0.15)] transition duration-300 group flex flex-col justify-between">
                    <div>
                        <div class="text-4xl md:text-5xl mb-4 animate-float group-hover:scale-110 transition"><%= r.emoji %></div>
                        <h3 class="text-xl md:text-2xl font-bold text-white mb-2"><%= r.name %></h3>
                        <p class="text-slate-400 text-xs md:text-sm h-10"><%= r.desc %></p>
                        <div class="my-4 py-4 border-y border-slate-800/50">
                            <p class="text-2xl md:text-3xl font-black text-emerald-400 drop-shadow-[0_0_10px_rgba(52,211,153,0.4)]">Rp <%= r.price.toLocaleString('id-ID') %></p>
                        </div>
                    </div>
                    <button onclick="buyRole('<%= r.id %>', <%= r.price %>)" class="w-full bg-slate-800 hover:bg-emerald-600 text-white font-bold py-3.5 rounded-xl border border-slate-700 hover:border-emerald-500 hover:shadow-[0_0_20px_rgba(16,185,129,0.4)] transition duration-300 text-sm md:text-base">
                        Pilih Paket
                    </button>
                </div>
            <% }) %>
        </div>
    </div>

    <!-- MODAL QRIS PAKASIR (FIXED AGAR TIDAK BUG/MELEBAR) -->
    <div id="qris-modal" class="hidden fixed inset-0 bg-slate-950/90 backdrop-blur-md z-[60] flex items-center justify-center p-4">
        <div class="glass-card p-6 md:p-8 rounded-3xl max-w-xs md:max-w-sm w-full text-center border border-slate-700 shadow-[0_0_50px_rgba(0,0,0,0.8)] relative">
            <h2 class="text-2xl font-bold mb-2">Scan QRIS</h2>
            <p class="text-slate-400 text-xs md:text-sm mb-4 border-b border-slate-800 pb-3">Sistem akan otomatis memproses setelah Anda membayar.</p>
            
            <!-- Pembungkus QR agar ukurannya konsisten dan tidak pecah/melebar -->
            <div class="bg-white p-3 rounded-2xl mb-4 inline-block mx-auto shadow-[0_0_15px_rgba(255,255,255,0.2)]">
                <div id="qr-image-container" class="w-48 h-48 md:w-56 md:h-56 flex items-center justify-center"></div>
            </div>

            <p id="qr-order-id" class="font-mono text-indigo-400 mb-5 font-bold text-xs md:text-sm bg-slate-900/50 py-2 px-3 rounded-lg truncate"></p>
            <button onclick="document.getElementById('qris-modal').classList.add('hidden')" class="w-full bg-slate-800 hover:bg-slate-700 font-bold py-3 rounded-xl transition text-sm">Tutup Modal</button>
        </div>
    </div>

    <!-- MODAL FLOATING PROMO VARESAMD (FIXED AGAR TIDAK BUG/MELEBAR) -->
    <div id="promo-modal" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-md z-[100] flex items-center justify-center p-4 opacity-0 transition-opacity duration-500">
        <div class="glass-card rounded-3xl max-w-xs md:max-w-sm w-full border border-indigo-500/50 shadow-[0_0_40px_rgba(99,102,241,0.2)] overflow-hidden relative transform scale-95 transition-transform duration-500 mx-auto" id="promo-content">
            <button onclick="closePromo()" class="absolute top-3 right-3 bg-slate-950/80 text-slate-300 hover:text-white p-2 rounded-full z-20 backdrop-blur-md transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
            
            <div class="relative h-44 w-full">
                <img src="https://raw.githubusercontent.com/ManzzyGacor/Urlmanzzy/main/file_1787080202458_944.jpg" alt="VaresaMD" class="w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-[rgba(15,23,42,1)] to-transparent"></div>
            </div>

            <div class="p-6 text-center -mt-6 relative z-10">
                <h2 class="text-2xl md:text-3xl font-black mb-1 bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400 bg-clip-text text-transparent drop-shadow-[0_0_10px_rgba(99,102,241,0.4)]">VaresaMD Bot</h2>
                <p class="text-emerald-400 font-extrabold text-base md:text-lg mb-3 drop-shadow-[0_0_8px_rgba(52,211,153,0.6)]">Mulai dari Rp 1.000 🔥</p>
                
                <div class="flex flex-wrap justify-center gap-1.5 mb-5 text-xs">
                    <span class="px-2.5 py-1 bg-indigo-500/10 border border-indigo-500/30 rounded-full font-bold text-indigo-300">🤖 Auto Respon</span>
                    <span class="px-2.5 py-1 bg-purple-500/10 border border-purple-500/30 rounded-full font-bold text-purple-300">🛡️ Anti Link</span>
                    <span class="px-2.5 py-1 bg-pink-500/10 border border-pink-500/30 rounded-full font-bold text-pink-300">🎮 Game Seru</span>
                </div>

                <a href="https://sewa.manzzy.web.id/" target="_blank" onclick="closePromo()" class="block w-full bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white font-bold py-3 rounded-xl shadow-[0_0_20px_rgba(99,102,241,0.4)] transition transform hover:-translate-y-0.5 text-sm">
                    Cek Website Sekarang 🚀
                </a>
            </div>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const promoModal = document.getElementById('promo-modal');
            const promoContent = document.getElementById('promo-content');
            if(!sessionStorage.getItem('promoShownDashboard')) {
                setTimeout(() => {
                    promoModal.classList.remove('hidden');
                    void promoModal.offsetWidth; 
                    promoModal.classList.remove('opacity-0');
                    promoContent.classList.remove('scale-95');
                    sessionStorage.setItem('promoShownDashboard', 'true');
                }, 800); 
            }
        });

        function closePromo() {
            const promoModal = document.getElementById('promo-modal');
            const promoContent = document.getElementById('promo-content');
            promoModal.classList.add('opacity-0');
            promoContent.classList.add('scale-95');
            setTimeout(() => { promoModal.classList.add('hidden'); }, 500);
        }

        async function processAm(step) {
            const btn = document.getElementById('btn-am');
            const container = document.getElementById('am-form-container');
            let payload = { step: step };
            
            if(step === 1) {
                const email = document.getElementById('am-email').value;
                if(!email) return Swal.fire('Error', 'Email tidak boleh kosong', 'error');
                payload.email = email;
            } else if(step === 2) {
                const url = document.getElementById('am-url').value;
                if(!url) return Swal.fire('Error', 'Link tidak boleh kosong', 'error');
                payload.url = url;
            }

            btn.innerText = "Memproses..."; btn.disabled = true;

            try {
                const res = await fetch('/api/am-process', {
                    method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload)
                });
                const data = await res.json();

                if(data.status) {
                    if(step === 1) {
                        document.getElementById('ui-step-1').className = 'step-inactive text-center w-1/3 py-2';
                        document.getElementById('ui-step-2').className = 'step-active text-center w-1/3 py-2 rounded-xl bg-slate-800/80 shadow-md';
                        
                        container.innerHTML = `
                            <input type="text" id="am-url" placeholder="Paste link verifikasi disini..." class="w-full bg-slate-900/80 border border-slate-700 rounded-xl px-5 py-4 text-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 mb-4 outline-none transition">
                            <button onclick="processAm(2)" id="btn-am" class="w-full bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 font-bold py-4 rounded-xl shadow-[0_0_20px_rgba(16,185,129,0.4)] transition transform hover:-translate-y-0.5">Verifikasi Sekarang</button>
                        `;
                        Swal.fire({icon: 'success', title: 'Berhasil', text: data.message, background: '#0f172a', color: '#fff'});
                    } else if (step === 2) {
                        document.getElementById('ui-step-2').className = 'step-inactive text-center w-1/3 py-2';
                        document.getElementById('ui-step-3').className = 'step-active text-center w-1/3 py-2 rounded-xl bg-slate-800/80 shadow-md';
                        
                        container.innerHTML = `
                            <div class="bg-emerald-500/10 border border-emerald-500/30 p-6 rounded-2xl text-center shadow-[0_0_20px_rgba(16,185,129,0.15)]">
                                <div class="text-5xl mb-3 animate-float">🎉</div>
                                <h3 class="text-xl font-bold text-emerald-400 mb-2 drop-shadow-[0_0_5px_rgba(52,211,153,0.5)]">Aktivasi Berhasil!</h3>
                                <p class="text-slate-400 text-sm mb-2">Code Order Anda:</p>
                                <div class="text-2xl md:text-3xl font-mono font-black text-white bg-slate-900 border border-slate-700 py-3 rounded-xl shadow-inner break-all">${data.codeorder}</div>
                            </div>
                            <button onclick="window.location.reload()" class="w-full bg-slate-800 hover:bg-slate-700 font-bold py-4 rounded-xl mt-4 border border-slate-700 transition">Buat Baru</button>
                        `;
                    }
                } else {
                    Swal.fire({icon: 'error', title: 'Gagal', text: data.message, background: '#0f172a', color: '#fff'});
                    btn.innerText = step === 1 ? "Kirim Magic Link" : "Verifikasi Sekarang"; btn.disabled = false;
                }
            } catch (err) {
                Swal.fire({icon: 'error', title: 'Server Error', text: 'Terjadi kesalahan sistem', background: '#0f172a', color: '#fff'});
                btn.disabled = false;
            }
        }

        async function buyRole(role, amount) {
            Swal.fire({ title: 'Membuat Tagihan...', allowOutsideClick: false, background: '#0f172a', color: '#fff', didOpen: () => { Swal.showLoading() } });
            
            const res = await fetch('/api/pay', {
                method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({role, amount})
            });
            const data = await res.json();
            Swal.close();

            if(data.status) {
                document.getElementById('qr-order-id').innerText = "Order ID: " + data.order_id;
                document.getElementById('qr-image-container').innerHTML = `<img src="https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=${encodeURIComponent(data.qr)}" alt="QRIS" class="w-full h-full object-contain rounded-lg">`;
                document.getElementById('qris-modal').classList.remove('hidden');
                checkPaymentStatus(data.order_id);
            } else {
                Swal.fire({icon: 'error', title: 'Gagal', text: 'Sistem Pembayaran Sedang Gangguan', background: '#0f172a', color: '#fff'});
            }
        }

        function checkPaymentStatus(order_id) {
            const check = setInterval(async () => {
                const res = await fetch('/api/check-status?order_id=' + order_id);
                const data = await res.json();
                if(data.status === 'completed') {
                    clearInterval(check);
                    Swal.fire({icon: 'success', title: 'Berhasil!', text: 'Role otomatis diupdate. Halaman akan dimuat ulang.', background: '#0f172a', color: '#fff'})
                    .then(() => window.location.reload());
                }
            }, 5000); 
        }
    </script>
</body>
</html>